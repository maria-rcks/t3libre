# Infra Pilot - Environment Settings
# Copy this file to .env, then run `bash scripts/generate-env.sh` (or
# `powershell -File scripts/generate-env.ps1`) to fill in secure random
# values for every empty secret below.

# --- App Settings ---
NODE_ENV=development
APP_VERSION=dev

# --- Database (PostgreSQL) ---
POSTGRES_USER=infra_pilot
POSTGRES_PASSWORD=
POSTGRES_DB=infra_pilot
POSTGRES_PORT=5432

# --- Cache (Redis) ---
REDIS_PORT=6379

# --- Web Panel ---
PORT=3001
MANAGEMENT_BACKEND_PORT=3001
MANAGEMENT_FRONTEND_PORT=5173
VITE_API_URL=http://localhost:3001
VITE_ENVIRONMENT=development
VITE_SUPABASE_URL=http://localhost:54321
# Public anon key of your Supabase project (not a secret, but required in production)
VITE_SUPABASE_ANON_KEY=

# --- Orchestrator (webhook/API server) ---
LOG_LEVEL=INFO
# Required for webhook security: GitHub webhook HMAC secret and GitOps bearer token
GITHUB_WEBHOOK_SECRET=
GITOPS_WEBHOOK_TOKEN=
# Bearer token for the /api/ route group; fails closed when set
FEDERATION_API_TOKEN=

# --- Load Testing (k6) ---
K6_SCENARIO=smoke
K6_SOAK_VUS=50
K6_SOAK_DURATION=30m
K6_SPIKE_MAX_VU=500
K6_MANIFEST_COUNT=1

# --- Discord Service ---
DISCORD_TOKEN=
PTERODACTYL_API_URL=http://localhost:8080/api
PTERODACTYL_API_KEY=
SERVER_CREATION_CHANNEL_ID=
LOCATION_ID=1
MAX_SERVERS_PER_USER=1

# --- Ports ---
ORCHESTRATOR_WEBHOOK_PORT=8500
DISCORD_WEBHOOK_PORT=3002

# Discord Bot Token (Required)
DISCORD_TOKEN=

# Pterodactyl API (Required)
PTERODACTYL_API_URL=https://your.pterodactyl.domain
PTERODACTYL_API_KEY=

# Discord channels & roles
SERVER_CREATION_CHANNEL_ID=your_channel_id_here
SERVER_CREATOR_ROLE_ID=your_role_id_here
WORKFLOW_NOTIFICATION_CHANNEL_ID=your_channel_id_here
SESSION_ALERT_CHANNEL_ID=your_channel_id_here
COMPLIANCE_ALERT_CHANNEL_ID=your_channel_id_here

# Limits
MAX_SERVERS_PER_USER=1

# Pterodactyl Egg IDs
MINECRAFT_EGG_ID=1
NODEJS_EGG_ID=2
TEAMSPEAK_EGG_ID=3
DATABASE_EGG_ID=4
PYTHON_EGG_ID=5

# Deploy location
LOCATION_ID=1

# Database (used by stats, economy, dashboard modules)
DB_HOST=postgres
DB_PORT=5432
DB_USER=infra_pilot
DB_PASSWORD=
DB_NAME=infra_pilot

# Backup retention per category (JSON: daily/weekly/monthly max count)
BACKUP_RETENTION='{"daily": 7, "weekly": 4, "monthly": 6}'

# Monitoring: admin user IDs for setalertthreshold (comma separated)
WHITELIST_IDS=

# Health checks: loop interval in seconds (min 10)
HEALTH_CHECK_INTERVAL_SECONDS=60

# Legacy VPS commands (deploy, port forwarding, credits)
DEFAULT_SSH_IMAGE=ubuntu:22.04
PUBLIC_IP=127.0.0.1
SERVER_LIMIT=5
# Configure to enable URL shortener in /deploy output
CUTTLY_API_KEY=

# Managed databases (MySQL containers)
MYSQL_ROOT_PASSWORD=
HOST_IP=127.0.0.1

# Disable the service without removing config
DISCORD_SERVICE_DISABLED=false

# Code Review / AI features
CODE_REVIEW_WEBHOOK_PORT=3000
CODE_REVIEW_WEBHOOK_SECRET=
AI_API_ENDPOINT=https://api.openai.com/v1/chat/completions
AI_API_KEY=
AI_MODEL=gpt-4
GITHUB_TOKEN=

# Integration service URL
INTEGRATION_SERVICE_URL=http://localhost:9000

# Reporting API base
API_BASE_URL=http://localhost:3001

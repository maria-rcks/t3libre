    white-space: nowrap;
    color: var(--rotator-accent, currentColor);
    opacity: 0;
    animation: hero-rotator-cycle 12s calc(var(--rotator-index) * 3s) infinite;
  }

  .hero-rotator-item__icon {
    width: 0.74em;
    height: 0.74em;
    flex: 0 0 auto;
    background: currentColor;
    mask: var(--rotator-icon) center / contain no-repeat;
    -webkit-mask: var(--rotator-icon) center / contain no-repeat;
    transform: translateY(-0.05em);
  }

  @keyframes hero-rotator-cycle {
    0% {
      opacity: 0;
      transform: translateY(0.3em);
    }

    5%,
    20% {
      opacity: 1;
      transform: translateY(0);
    }

    25%,
    100% {
      opacity: 0;
      transform: translateY(-0.3em);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-rotator-item {
      animation: none;
    }

    .hero-rotator-item:first-child {
      opacity: 1;
    }
  }


  @keyframes hero-copy-reveal {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero {
    --hero-concept-accent: #d0ccff;
    transition:
      color 0.72s cubic-bezier(0.22, 1, 0.36, 1),
      background 0.72s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .hero[data-hero-variant="4"] {
    --hero-concept-accent: #bcb5ff;
    color: #f7f6ff;
    background:
      radial-gradient(circle at 72% 46%, rgba(99, 83, 190, 0.16), transparent 34%),
      linear-gradient(145deg, #09090d 0%, #030304 72%);
  }
  .hero[data-hero-variant="1"] .hero-title,
  .hero[data-hero-variant="4"] .hero-title {
    max-width: 430px;
    font-size: clamp(50px, 4.5vw, 66px);
  }

  .hero-copy,
  .hero-preview {
    transition:
      transform 0.72s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.42s ease;
  }

  .hero-preview {
    position: relative;
    z-index: 2;
  }

  .hero-preview::before {
    position: absolute;
    top: 50%;
    left: -58px;
    width: 58px;
    height: 1px;
    z-index: 3;
    background: linear-gradient(90deg, transparent, var(--hero-concept-accent));
    box-shadow: 0 0 14px
      color-mix(in srgb, var(--hero-concept-accent) 40%, transparent);
    content: "";
    pointer-events: none;
    transform-origin: left;
  }

  .hero-preview::after {
    position: absolute;
    top: calc(50% - 3px);
    left: -6px;
    width: 6px;
    height: 6px;
    z-index: 4;
    border-radius: 50%;
    background: var(--hero-concept-accent);
    box-shadow: 0 0 18px var(--hero-concept-accent);
    content: "";
    pointer-events: none;
  }

  .hero[data-hero-variant="1"] .hero-preview {
    opacity: 1;
    transform: perspective(1600px) translateX(14px) rotateY(-2deg) scale(0.98);
    animation: app-arrive-1 0.82s 260ms cubic-bezier(0.22, 1, 0.36, 1)
      backwards;
  }

  .hero[data-hero-variant="1"] .hero-preview::before {
    animation: app-signal-line-1 0.55s 720ms cubic-bezier(0.22, 1, 0.36, 1)
      backwards;
  }

  .hero[data-hero-variant="1"] .hero-preview::after {
    animation: app-signal-dot-1 0.55s 720ms cubic-bezier(0.22, 1, 0.36, 1)
      backwards;
  }

  .hero[data-hero-variant="4"] .stage-sky {
    opacity: 0.24;
  }
  .hero[data-hero-variant="4"] .hero-preview {
    opacity: 1;
    transform: perspective(1500px) translateX(8px) rotateY(-1deg) scale(0.96);
    animation: app-arrive-4 0.82s 260ms cubic-bezier(0.22, 1, 0.36, 1)
      backwards;
  }
  .hero[data-hero-variant="4"] .hero-preview::before {
    animation: app-signal-line-4 0.55s 720ms cubic-bezier(0.22, 1, 0.36, 1)
      backwards;
  }
  .hero[data-hero-variant="4"] .hero-preview::after {
    animation: app-signal-dot-4 0.55s 720ms cubic-bezier(0.22, 1, 0.36, 1)
      backwards;
  }
  .hero[data-hero-variant="4"] .hero-demo-frame.is-ready {
    filter: saturate(0.92) contrast(1.04);
    animation: none;
  }
  .hero[data-hero-variant="4"] #download-btn {
    color: #09090b;
    background: #f2f0ff;
  }
  .hero[data-hero-variant="4"] .mobile-download-links a {
    color: rgba(255, 255, 255, 0.58);
  }
  .hero[data-hero-variant="4"] .mobile-download-links img {
    filter: saturate(0.72) brightness(0.92);
  }

  @keyframes app-arrive-1 {
    from {
      opacity: 0;
      filter: blur(8px);
      transform: perspective(1600px) translate3d(76px, 16px, 0)
        rotateY(-7deg) scale(0.92);
    }
  }

  @keyframes app-arrive-4 {
    from {
      opacity: 0;
      filter: blur(8px);
      transform: perspective(1500px) translate3d(64px, 20px, 0)
        rotateY(-5deg) scale(0.9);
    }
  }

  @keyframes app-signal-line-1 {
    from {
      opacity: 0;
      transform: scaleX(0);
    }
  }

  @keyframes app-signal-line-4 {
    from {
      opacity: 0;
      transform: scaleX(0);
    }
  }

  @keyframes app-signal-dot-1 {
    from {
      opacity: 0;
      transform: translateX(-52px) scale(0.5);
    }
  }

  @keyframes app-signal-dot-4 {
    from {
      opacity: 0;
      transform: translateX(-52px) scale(0.5);
    }
  }

  .hero-actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
  }

  .hero-download-row {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    gap: 12px;
  }

  .mobile-download-links {
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    gap: 16px;
    width: 100%;
  }

  .mobile-download-links a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 1px 0;
    color: var(--fg-dim);
    font-size: 12px;
    font-weight: 500;
    text-decoration: none;
    transition: color 0.18s ease;
  }

  .mobile-download-links a:hover,
  .mobile-download-links a:focus-visible {
    color: var(--fg);
  }

  .mobile-download-links img {
    width: 16px;
    height: 16px;
    flex: 0 0 auto;
    filter: saturate(0.78) brightness(0.88);
    object-fit: contain;
    opacity: 0.76;
    transition:
      filter 0.18s ease,
      opacity 0.18s ease;
  }

  .mobile-download-links a:hover img,
  .mobile-download-links a:focus-visible img {
    filter: saturate(0.9) brightness(0.96);
    opacity: 0.92;
  }

  /* Download channel picker. */
  .channel-picker {
    position: relative;
    width: 100%;
    min-height: 27px;
  }

  #cta-channel-btn,
  #hero-channel-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 0;
    color: var(--fg-muted);
    font-size: 13px;
    font-weight: 500;
    background: transparent;
    border: 0;
    cursor: pointer;
    transition: color 0.18s ease;
  }

  #cta-channel-btn:hover,
  #hero-channel-btn:hover {
    color: var(--fg);
  }

  #cta-channel-menu,
  #hero-channel-menu {
    position: absolute;
    top: calc(100% + 4px);
    left: 0;
    min-width: 96px;
    padding: 4px 0;
    background: transparent;
    border: 0;
    box-shadow: none;
    z-index: 20;
  }

  #cta-channel-menu button,
  #hero-channel-menu button {
    display: block;
    width: 100%;
    padding: 5px 0;
    border: 0;
    background: transparent;
    color: var(--fg-muted);
    font-size: 13px;
    font-weight: 400;
    cursor: pointer;
    text-align: left;
    transition: color 0.18s ease;
  }

  #cta-channel-menu button:hover,
  #hero-channel-menu button:hover {
    color: var(--fg);
  }

  #cta-channel-menu button[data-active="true"],
  #hero-channel-menu button[data-active="true"] {
    color: var(--fg);
  }

  /* Download button icons (platform-aware) */
  .dl-icon {
    display: none;
    width: 14px;
    height: 14px;
    flex-shrink: 0;
  }

  :global([data-platform="mac"]) .dl-icon--apple,
  :global([data-platform="ios"]) .dl-icon--apple {
    display: block;
  }
  :global([data-platform="win"]) .dl-icon--windows {
    display: block;
  }
  :global([data-platform="linux"]) .dl-icon--linux {
    display: block;
  }
  :global(html:not([data-platform])) .dl-icon--apple {
    display: block;
  }

  /* The app always renders at a desktop viewport and scales down with its
     frame. That preserves the real desktop chrome and T3 Code wordmark even
     in the narrower side-by-side layouts. */
  .hero,
  .sec-showcase {
    --preview-fade-duration: 1400ms;
    --preview-fade-easing: cubic-bezier(0.22, 1, 0.36, 1);
  }

  .hero-preview {
    position: relative;
    z-index: 2;
  }

  .hero-demo-frame {
    position: relative;
    overflow: hidden;
    aspect-ratio: 1200 / 804;
    width: 100%;
    contain: layout paint;
    isolation: isolate;
    border-radius: 14px;
    background: #000;
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 28px 64px -28px rgba(0, 0, 0, 0.75);
    filter: brightness(0) saturate(0);
    opacity: 1;
    transform-style: preserve-3d;
    transition:
      transform 0.8s cubic-bezier(0.22, 1, 0.36, 1),
      border-color 0.5s ease,
      box-shadow 0.8s cubic-bezier(0.22, 1, 0.36, 1);
    will-change: opacity, filter, transform;
  }

  .hero-demo-frame.is-ready {
    filter: brightness(1) saturate(1);
    opacity: 1;
    animation: preview-frame-reveal var(--preview-fade-duration)
      var(--preview-fade-easing) both;
  }

  @keyframes preview-frame-reveal {
    0%,
    14% {
      filter: brightness(0) saturate(0);
      opacity: 1;
    }
    100% {
      filter: brightness(1) saturate(1);
      opacity: 1;
    }
  }

  .hero-demo-frame iframe {
    position: absolute;
    top: 0;
    left: 0;
    display: block;
    width: 1200px;
    height: 804px;
    border: 0;
    background: #000;
    transform-origin: top left;
  }

  /* 2: split stage, the original composition with more room for the app. */
  .hero--layout-2 .hero-inner {
    display: grid;
    grid-template-columns: minmax(340px, 390px) minmax(0, 1fr);
    gap: 44px;
    align-items: center;
    max-width: 1240px;
  }

  .hero--layout-2 {
    display: flex;
    min-height: 100svh;
    align-items: center;
    padding-block: 64px;
  }

  .hero--layout-2 .hero-copy {
    max-width: 390px;
  }

  .hero--layout-2 .hero-preview {
    width: 100%;
  }

  .hero[data-hero-variant="4"] .hero-inner {
    grid-template-columns: minmax(370px, 430px) minmax(0, 1fr);
    gap: 24px;
  }

  .hero[data-hero-variant="1"] .hero-inner {
    grid-template-columns: minmax(370px, 430px) minmax(0, 1fr);
    gap: 24px;
  }

  /* Store-linked iPhone and iPad cards riding the hero's right edge. */
  .hero-mobile-store {
    position: absolute;
    right: max(28px, calc((100vw - 1380px) / 2));
    bottom: 34px;
    width: 370px;
    height: 410px;
    z-index: 4;
    filter: brightness(0) saturate(0);
    opacity: 0;
    pointer-events: none;
    transform: translate3d(16px, 12px, 0) scale(0.96);
    transition:
      opacity 0.48s ease,
      transform 0.72s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .hero-mobile-store.is-loaded {
    filter: brightness(1) saturate(1);
  }

  .hero[data-hero-variant="1"] .hero-mobile-store.is-loaded,
  .hero[data-hero-variant="4"] .hero-mobile-store.is-loaded {
    opacity: 1;
    pointer-events: auto;
    transform: translate3d(0, 0, 0) scale(1);
    animation: preview-frame-reveal var(--preview-fade-duration)
      var(--preview-fade-easing) both;
  }

  .hero[data-hero-variant="1"] .hero-mobile-store.is-loaded {
    opacity: 0.8;
    transform: translate3d(48px, 54px, 0) scale(0.82);
  }

  .hero-mobile-showcase {
    display: none;
  }

  .hero-device-card {
    position: absolute;
    display: block;
    overflow: hidden;
    padding: 5px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    color: #fff;
    background: #0a0a0c;
    box-shadow:
      0 24px 60px rgba(0, 0, 0, 0.48),
      inset 0 1px rgba(255, 255, 255, 0.08);
    text-decoration: none;
    transition:
      transform 0.24s cubic-bezier(0.22, 1, 0.36, 1),
      border-color 0.18s ease,
      box-shadow 0.24s ease;
  }

  .hero-device-card img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: inherit;
  }

  .hero-device-card span {
    position: absolute;
    right: 10px;
    bottom: 10px;
    padding: 5px 8px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 999px;
    color: rgba(255, 255, 255, 0.9);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: -0.01em;
    background: rgba(4, 4, 5, 0.76);
    box-shadow: 0 8px 22px rgba(0, 0, 0, 0.32);
    backdrop-filter: blur(12px);
    opacity: 0;
    transform: translateY(4px);
    transition:
      opacity 0.18s ease,
      transform 0.18s ease;
  }

  .hero-device-card--tablet {
    top: 0;
    right: 0;
    width: 282px;
    border-radius: 25px;
    transform: rotate(3deg);
  }

  .hero-device-card--phone {
    bottom: 0;
    left: 0;
    width: 166px;
    border-radius: 27px;
    transform: rotate(-4deg);
  }

  .hero[data-hero-variant="1"] .hero-device-card--tablet {
    animation: tablet-arrive-1 0.72s 640ms cubic-bezier(0.22, 1, 0.36, 1)
      backwards;
  }

  .hero[data-hero-variant="1"] .hero-device-card--phone {
    animation: phone-arrive-1 0.72s 760ms cubic-bezier(0.22, 1, 0.36, 1)
      backwards;
  }

  .hero[data-hero-variant="4"] .hero-device-card--tablet {
    animation: tablet-arrive-4 0.72s 580ms cubic-bezier(0.22, 1, 0.36, 1)
      backwards;
  }

  .hero[data-hero-variant="4"] .hero-device-card--phone {
    animation: phone-arrive-4 0.72s 700ms cubic-bezier(0.22, 1, 0.36, 1)
      backwards;
  }

  @keyframes tablet-arrive-1 {
    from {
      opacity: 0;
      transform: translate3d(64px, 38px, 0) rotate(10deg) scale(0.84);
    }
  }

  @keyframes phone-arrive-1 {
    from {
      opacity: 0;
      transform: translate3d(54px, 64px, 0) rotate(7deg) scale(0.8);
    }
  }

  @keyframes tablet-arrive-4 {
    from {
      opacity: 0;
      transform: translate3d(82px, 46px, 0) rotate(12deg) scale(0.8);
    }
  }

  @keyframes phone-arrive-4 {
    from {
      opacity: 0;
      transform: translate3d(68px, 76px, 0) rotate(8deg) scale(0.76);
    }
  }

  .hero-mobile-store:hover .hero-device-card--tablet,
  .hero-mobile-store:focus-within .hero-device-card--tablet {
    transform: translate(9px, -8px) rotate(7deg);
  }

  .hero-mobile-store:hover .hero-device-card--phone,
  .hero-mobile-store:focus-within .hero-device-card--phone {
    transform: translate(-7px, -10px) rotate(-7deg);
  }

  .hero-device-card:hover,
  .hero-device-card:focus-visible {
    z-index: 4;
    border-color: rgba(255, 255, 255, 0.3);
    box-shadow:
      0 30px 72px rgba(0, 0, 0, 0.56),
      inset 0 1px rgba(255, 255, 255, 0.12);
    outline: none;
  }

  .hero-device-card:hover span,
  .hero-device-card:focus-visible span {
    opacity: 1;
    transform: translateY(0);
  }

  /* ── One live thread, every screen ─────────────────────── */
  .sec-connect {
    height: 280svh;
    padding: 0;
    border-top: 0;
    background:
      radial-gradient(circle at 50% 48%, rgba(111, 92, 230, 0.1), transparent 36%),
      #050506;
  }

  .connect-sticky {
    position: sticky;
    top: 0;
    display: grid;
    height: 100svh;
    overflow: hidden;
    place-items: center;
  }

  .connect-stage {
    --connect-route-progress: 0;
    position: relative;
    width: min(100%, 1440px);
    height: min(100svh, 820px);
    overflow: hidden;
    isolation: isolate;
  }

  .connect-stage::before {
    position: absolute;
    inset: 8% 8%;
    z-index: -1;
    border-radius: 50%;
    background: rgba(116, 94, 235, 0.1);
    content: "";
    filter: blur(120px);
    pointer-events: none;
  }

  .connect-stage::after {
    position: absolute;
    inset: 0;
    z-index: 0;
    background-image: radial-gradient(
      rgba(214, 208, 255, 0.2) 1px,
      transparent 1px
    );
    background-size: 26px 26px;
    content: "";
    mask-image: radial-gradient(
      ellipse 58% 54% at 50% 46%,
      #000 12%,
      transparent 68%
    );
    opacity: 0.5;
    pointer-events: none;
  }

  .connect-statement {
    position: absolute;
    top: 5%;
    left: 50%;
    z-index: 8;
    margin: 0;
    background: linear-gradient(180deg, #f6f4ff 6%, #b3a8ff 94%);
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
    font-size: clamp(40px, 5vw, 70px);
    font-weight: 500;
    letter-spacing: -0.06em;
    line-height: 0.9;
    text-align: center;
    transform: translate3d(-50%, 24px, 0);
    opacity: 0;
    pointer-events: none;
  }

  .connect-statement span {
    display: block;
    white-space: nowrap;
  }

  .connect-host {
    position: absolute;
    top: 10%;
    left: 50%;
    z-index: 7;
    display: flex;
    min-height: 62px;
    align-items: center;
    gap: 11px;
    padding: 9px 11px 9px 14px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 15px;
    color: rgba(255, 255, 255, 0.84);
    background: rgba(10, 10, 13, 0.9);
    box-shadow:
      inset 0 1px rgba(255, 255, 255, 0.07),
      0 24px 70px rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(20px);
    transform: translate3d(-50%, 0, 0);
  }

  .connect-host__status,
  .connect-frame__label i,
  .connect-thread-event__pulse {
    position: relative;
    width: 7px;
    height: 7px;
    flex: 0 0 auto;
    border-radius: 50%;
    background: #9fe88f;
    box-shadow: 0 0 14px rgba(159, 232, 143, 0.65);
  }

  .connect-host__status::after {
    position: absolute;
    inset: -2px;
    border: 1px solid rgba(159, 232, 143, 0.75);
    border-radius: 50%;
    content: "";
    animation: connect-status-ping 2.4s cubic-bezier(0, 0, 0.2, 1) infinite;
  }

  @keyframes connect-status-ping {
    0% {
      opacity: 0.9;
      transform: scale(0.66);
    }

    72%,
    100% {
      opacity: 0;
      transform: scale(2.4);
    }
  }

  .connect-thread-event [data-connect-sync]::after {
    display: inline-block;
    width: 5px;
    height: 0.86em;
    margin-left: 3px;
    background: #cfc7ff;
    content: "";
    vertical-align: -0.1em;
    animation: connect-caret-blink 1.1s steps(2, start) infinite;
  }

  @keyframes connect-caret-blink {
    to {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .connect-routes .connect-routes__pulse,
    .connect-host__status::after,
    .connect-thread-event [data-connect-sync]::after {
      animation: none;
    }

    .connect-routes .connect-routes__pulse {
      opacity: 0;
    }
  }

  .connect-host strong {
    font-size: 11px;
    font-weight: 600;
    white-space: nowrap;
  }

  .connect-host__agents {
    display: flex;
    align-items: center;
    padding-left: 8px;
    border-left: 1px solid rgba(255, 255, 255, 0.1);
  }

  .connect-host__agents img {
    width: 25px;
    height: 25px;
    padding: 4px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    background: #111116;
    object-fit: contain;
  }

  .connect-host__agents img + img {
    margin-left: -4px;
  }

  .connect-host__arrow {
    color: #a89cff;
    font-size: 15px;
  }

  .connect-host__t3 {
    width: 42px;
    height: 42px;
    border-radius: 10px;
    box-shadow: 0 0 24px rgba(139, 120, 255, 0.22);
  }

  .connect-routes {
    position: absolute;
    inset: 0;
    z-index: 2;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }

  .connect-routes path {
    fill: none;
    stroke: rgba(171, 159, 255, 0.34);
    stroke-dasharray: 1;
    stroke-dashoffset: calc(1 - var(--connect-route-progress));
    stroke-linecap: round;
    stroke-width: 1.25;
    vector-effect: non-scaling-stroke;
    filter: drop-shadow(0 0 7px rgba(154, 137, 255, 0.3));
  }

  .connect-routes .connect-routes__pulse {
    stroke: #ded8ff;
    stroke-dasharray: 0.055 0.945;
    stroke-width: 1.7;
    opacity: var(--connect-route-progress);
    filter: drop-shadow(0 0 6px rgba(203, 191, 255, 0.9));
    animation: connect-route-pulse 2.8s linear var(--pulse-delay, 0s) infinite;
  }

  @keyframes connect-route-pulse {
    from {
      stroke-dashoffset: 1.055;
    }

    to {
      stroke-dashoffset: 0.055;
    }
  }

  .connect-frame {
    position: absolute;
    z-index: 3;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 16px;
    color: #fff;
    background: #08080a;
    box-shadow:
      inset 0 1px rgba(255, 255, 255, 0.075),
      0 30px 90px rgba(0, 0, 0, 0.62);
    opacity: 0;
    transform: translate3d(0, 54px, 0) scale(0.82);
    transform-origin: center;
    will-change: transform, opacity;
  }

  .connect-frame--desktop {
    top: 50%;
    left: 50%;
    z-index: 4;
    width: clamp(640px, 56vw, 860px);
    aspect-ratio: 1200 / 850;
    opacity: 1;
    transform: translate3d(-50%, -50%, 0) scale(1);
  }

  .connect-frame--web {
    top: 22%;
    right: 8.6%;
    width: min(34%, 480px);
    aspect-ratio: 2430 / 1475;
  }

  .connect-frame--ipad {
    right: 12.6%;
    bottom: 4%;
    width: min(31%, 430px);
    aspect-ratio: 4 / 3;
  }

  .connect-frame--iphone {
    right: 33.6%;
    bottom: 2%;
    z-index: 5;
    width: min(10.5%, 144px);
    aspect-ratio: 1320 / 2868;
    border-radius: 22px;
  }

  .connect-frame--android {
    right: 6.1%;
    bottom: 16%;
    z-index: 5;
    width: min(10.5%, 144px);
    aspect-ratio: 1080 / 1920;
    border-radius: 22px;
  }

  /* Companion screens stay minimal: a labeled glass frame with a faint UI
     skeleton, so only the desktop app shows real product pixels. */
  .connect-frame--web,
  .connect-frame--ipad,
  .connect-frame--iphone,
  .connect-frame--android {
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.028), transparent 42%),
      rgba(9, 9, 12, 0.72);
    backdrop-filter: blur(10px);
  }

  .connect-frame__ghost {
    position: absolute;
    inset: 42px 14px 14px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    pointer-events: none;
  }

  .connect-frame__ghost span {
    height: 8px;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.05);
  }

  .connect-frame__ghost span:nth-child(1) {
    width: 46%;
  }

  .connect-frame__ghost span:nth-child(2) {
    width: 72%;
  }

  .connect-frame__ghost span:nth-child(3) {
    width: 32%;
  }

  .connect-frame--iphone .connect-frame__ghost,
  .connect-frame--android .connect-frame__ghost {
    inset: 33px 9px 9px;
    gap: 6px;
  }

  .connect-frame--iphone .connect-frame__ghost span,
  .connect-frame--android .connect-frame__ghost span {
    height: 5px;
  }

  .connect-frame__bar {
    position: absolute;
    top: 0;
    right: 0;
    left: 0;
    z-index: 4;
    display: flex;
    height: 30px;
    align-items: center;
    justify-content: space-between;
    padding: 0 10px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(8, 8, 11, 0.88);
    backdrop-filter: blur(14px);
  }

  .connect-frame--iphone .connect-frame__bar,
  .connect-frame--android .connect-frame__bar {
    height: 23px;
    justify-content: center;
    padding: 0 5px;
  }

  .connect-frame--web .connect-frame__bar,
  .connect-frame--ipad .connect-frame__bar,
  .connect-frame--iphone .connect-frame__bar,
  .connect-frame--android .connect-frame__bar {
    border-bottom-color: rgba(255, 255, 255, 0.06);
    background: transparent;
    backdrop-filter: none;
  }

  .connect-frame__traffic {
    display: flex;
    gap: 4px;
  }

  .connect-frame__traffic i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.2);
  }

  .connect-frame__label {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: rgba(255, 255, 255, 0.62);
    font-family: var(--font-mono);
    font-size: 8px;
    line-height: 1;
  }

  .connect-frame__label i {
    width: 5px;
    height: 5px;
  }

  .connect-frame__viewport {
    position: absolute;
    top: 30px;
    right: 0;
    bottom: 0;
    left: 0;
    overflow: hidden;
    background: #000;
  }

  .connect-frame__viewport iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 1200px;
    height: 804px;
    border: 0;
    pointer-events: none;
    transform-origin: top left;
  }

  .connect-thread-event {
    position: absolute;
    right: 10px;
    bottom: 10px;
    left: 10px;
    z-index: 6;
    display: flex;
    min-height: 32px;
    align-items: center;
    gap: 8px;
    padding: 7px 10px;
    border: 1px solid rgba(190, 181, 255, 0.24);
    border-radius: 9px;
    color: rgba(255, 255, 255, 0.9);
    font-family: var(--font-mono);
    font-size: 9px;
    line-height: 1.3;
    background: rgba(13, 12, 19, 0.88);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.42);
    backdrop-filter: blur(14px);
  }

  .connect-frame--desktop .connect-thread-event {
    right: 22px;
    bottom: 22px;
    left: auto;
    width: min(360px, 52%);
    min-height: 38px;
    font-size: 10px;
  }

  .connect-frame--iphone .connect-thread-event,
  .connect-frame--android .connect-thread-event {
    right: 5px;
    bottom: 6px;
    left: 5px;
    min-height: 24px;
    gap: 4px;
    padding: 5px;
    border-radius: 6px;
    font-size: 5px;
  }

  .connect-thread-event__pulse {
    background: #b8aeff;
    box-shadow: 0 0 14px rgba(184, 174, 255, 0.8);
  }

  /* ── Endorsements ─────────────────────────────────────── */
  .sec-endorsements {
    overflow: hidden;
    border-top: 0;
  }

  .endorsements-head {
    max-width: 720px;
    margin-bottom: 56px;
  }

  .endorsements-head h2 {
    font-size: clamp(32px, 4vw, 48px);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1.05;
    margin-bottom: 18px;
  }

  .endorsements-count {
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .endorsements-head p {
    color: var(--fg-muted);
    font-size: 18px;
    max-width: 620px;
    letter-spacing: -0.005em;
  }

  .endorsement-carousel {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .endorsement-carousel--mobile {
    display: none;
  }

  .endorsement-carousel::before,
  .endorsement-carousel::after {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    z-index: 2;
    width: max(48px, calc((100vw - 1240px) / 2 + 56px));
    pointer-events: none;
  }

  .endorsement-carousel::before {
    left: 0;
    background: linear-gradient(90deg, var(--bg), transparent);
  }

  .endorsement-carousel::after {
    right: 0;
    background: linear-gradient(270deg, var(--bg), transparent);
  }

  .endorsement-row {
    overflow: hidden;
  }

  .endorsement-track {
    width: max-content;
    display: flex;
    animation: endorsementMarquee 76s linear infinite;
    will-change: transform;
  }

  .endorsement-track-group {
    display: flex;
    gap: 12px;
    padding-right: 12px;
  }

  .endorsement-row.is-reverse .endorsement-track {
    animation-direction: reverse;
    animation-duration: 84s;
  }

  .endorsement-carousel:hover .endorsement-track,
  .endorsement-carousel:focus-within .endorsement-track {
    animation-play-state: paused;
  }

  .endorsement-card {
    position: relative;
    width: clamp(264px, 22vw, 308px);
    height: 132px;
    padding: 14px 16px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.012);
    transition:
      border-color 0.18s ease,
      background 0.18s ease;
  }

  .endorsement-card:hover {
    border-color: var(--border-strong);
    background: rgba(255, 255, 255, 0.03);
  }

  .endorsement-author {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
  }

  .endorsement-author img {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }

  .endorsement-handle {
    color: var(--fg-muted);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: -0.005em;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .endorsement-card p {
    color: var(--fg);
    font-size: 13.5px;
    line-height: 1.4;
    letter-spacing: -0.003em;
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  /* ── Screenshot walkthroughs ───────────────────────────── */
  .sec-showcase {
    overflow: hidden;
    padding: 48px 0;
    border-top: 0;
  }

  .showcase-inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(36px, 5vw, 64px);
    align-items: center;
  }

  .showcase-inner--image-left {
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
  }

  .showcase-inner--image-left .showcase-visual {
    order: -1;
    justify-self: start;
  }

  .showcase-inner--image-left .showcase-copy .section-head {
    align-items: flex-end;
    margin-left: auto;
    text-align: right;
  }

  .showcase-inner--image-left .showcase-copy .section-head p {
    margin-left: auto;
  }

  .showcase-inner--image-left .showcase-link {
    align-self: flex-end;
  }

  .showcase-copy .section-head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    max-width: none;
    margin: 0;
    text-align: left;
  }

  .showcase-copy .section-head h2 {
    margin-bottom: 10px;
    font-size: clamp(32px, 3vw, 42px);
  }

  .showcase-copy .section-head p {
    max-width: none;
    margin: 0;
    font-size: 16px;
    line-height: 1.45;
  }

  .showcase-link {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    margin-top: 18px;
    color: var(--fg-dim);
    font-size: 13px;
    font-weight: 500;
    line-height: 1.2;
    text-decoration: none;
    transition: color 0.18s ease;
  }

  .showcase-link:hover {
    color: var(--fg);
  }

  .showcase-link:focus-visible {
    border-radius: 3px;
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }

  .showcase-link svg {
    flex: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.5;
    transition: transform 0.18s ease;
  }

  .showcase-link:hover svg {
    transform: translateX(2px);
  }

  @media (min-width: 961px) {
    .showcase-copy .section-head h2,
    .showcase-copy .section-head p {
      white-space: nowrap;
    }
  }

  .showcase-visual {
    width: 100%;
    min-width: 0;
    margin: 0;
    justify-self: end;
  }

  .showcase-stage {
    position: relative;
    overflow: hidden;
    aspect-ratio: var(--showcase-ratio);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 18px;
    background: #080808;
    box-shadow:
      inset 0 1px rgba(255, 255, 255, 0.06),
      0 38px 100px -46px rgba(0, 0, 0, 0.95);
    contain: layout paint;
    isolation: isolate;
  }

  .showcase-panel {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: inherit;
    margin: 0;
  }

  .showcase-image {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: inherit;
    object-fit: cover;
  }

  @media (prefers-reduced-motion: reduce) {
    #download-btn,
    .cta-card,
    .cta-card::before,
    .cta-stage-art,
    .cta-app-icon,
    .faq-chevron,
    .hero-concept,
    .hero-demo-frame,
    .hero-mobile-store,
    .hero-preview,
    .hero-preview::before,
    .hero-preview::after,
    .hero-mobile-showcase,
    .hero-mobile-showcase__screen,
    .hero-mobile-showcase__dots button,
    .hero-device-card,
    .mobile-download-links a,
    .endorsement-track {
      animation: none;
      transition: none;
    }
  }

  /* ── Terminal ─────────────────────────────────────────── */
  .open-term {
    padding: 0;
    overflow: hidden;
  }
  .open-source-terminal {
    border-color: rgba(255, 255, 255, 0.12);
    border-radius: 18px;
    background: #080808;
    box-shadow:
      inset 0 1px rgba(255, 255, 255, 0.06),
      0 38px 100px -46px rgba(0, 0, 0, 0.95);
  }
  .open-term-body {
    padding: 20px 22px;
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.7;
    color: var(--fg);
  }
  .open-term-body > div {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .open-term-body .prompt {
    color: var(--accent);
    margin-right: 8px;
  }
  .open-term-body .dim {
    color: var(--fg-dim);
  }
  .open-term-body .accent {
    color: var(--accent);
  }
  .open-term-body .cursor {
    display: flex;
    align-items: center;
  }
  .terminal-user {
    color: #a6e3a1;
  }
  .terminal-path {
    color: #89b4fa;
    margin-left: 6px;
  }
  .terminal-spacer {
    height: 8px;
    line-height: 0;
  }
  .caret {
    display: inline-block;
    width: 7px;
    height: 14px;
    background: var(--fg);
    margin-left: 4px;
    animation: blink 1s steps(2) infinite;
  }

  /* ── Open source ──────────────────────────────────────── */
  .sec-open {
    border-top: 0;
  }

  .open-simple {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    grid-template-rows: auto auto;
    align-items: center;
    column-gap: 64px;
    row-gap: 28px;
    text-align: left;
  }

  .open-simple-copy {
    align-self: end;
  }

  .open-simple-copy h2 {
    margin-bottom: 14px;
    font-size: clamp(36px, 4vw, 48px);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1.05;
  }

  .open-simple-copy p {
    color: var(--fg-muted);
    font-size: 18px;
  }

  .open-source-terminal {
    width: 100%;
    grid-column: 2;
    grid-row: 1 / span 2;
    text-align: left;
  }

  .open-simple-action {
    flex: none;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    align-self: start;
    gap: 14px;
  }

  /* ── FAQ ──────────────────────────────────────────────── */
  .sec-faq {
    --faq-accent: rgba(255, 255, 255, 0.68);
    --faq-surface: rgba(255, 255, 255, 0.045);
    --faq-surface-active: rgba(255, 255, 255, 0.072);
    padding: 72px 0 88px;
    border-top: 0;
  }

  :global(html[data-stage="nightly"]) .sec-faq {
    --faq-accent: rgb(183, 174, 255);
    --faq-surface: rgba(139, 129, 255, 0.075);
    --faq-surface-active: rgba(139, 129, 255, 0.125);
  }

  :global(html[data-stage="dev"]) .sec-faq {
    --faq-accent: rgb(150, 201, 255);
    --faq-surface: rgba(105, 180, 255, 0.075);
    --faq-surface-active: rgba(105, 180, 255, 0.125);
  }

  .faq-shell {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
  }

  .faq-head {
    text-align: center;
  }

  .faq-head h2 {
    color: var(--fg-muted);
    font-size: 16px;
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  .faq-list {
    display: grid;
    gap: 6px;
    width: min(760px, 100%);
  }

  .faq-item {
    overflow: hidden;
    border-radius: 12px;
    background: var(--faq-surface);
    transition: background 0.18s ease;
  }

  .faq-item:hover,
  .faq-item[open] {
    background: var(--faq-surface-active);
  }

  .faq-item summary {
    display: flex;
    gap: 16px;
    align-items: center;
    justify-content: space-between;
    padding: 18px 20px;
    border-radius: 12px;
    color: rgba(255, 255, 255, 0.82);
    cursor: pointer;
    font-size: 17px;
    font-weight: 500;
    letter-spacing: -0.012em;
    line-height: 1.25;
    list-style: none;
    user-select: none;
    -webkit-user-select: none;
    transition: color 0.18s ease;
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-item summary::marker {
    content: "";
  }

  .faq-item summary:hover,
  .faq-item[open] summary {
    color: var(--fg);
  }

  .faq-item summary:focus-visible {
    outline: 2px solid var(--faq-accent);
    outline-offset: 2px;
  }

  .faq-chevron {
    position: relative;
    flex: 0 0 auto;
    display: grid;
    width: 18px;
    height: 18px;
    place-items: center;
    color: var(--faq-accent);
  }

  .faq-chevron::before {
    content: "";
    width: 7px;
    height: 7px;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: translateY(-2px) rotate(45deg);
    transition: transform 0.2s ease;
  }

  .faq-item[open] .faq-chevron::before {
    transform: translateY(2px) rotate(225deg);
  }

  .faq-answer {
    padding: 0 48px 18px 20px;
  }

  .faq-answer p {
    color: var(--fg-muted);
    font-size: 15.5px;
    line-height: 1.5;
  }

  .faq-answer a {
    color: var(--faq-accent);
    white-space: nowrap;
    transition: color 0.18s ease;
  }

  .faq-answer a:hover {
    color: var(--fg);
  }

  /* ── Final CTA ────────────────────────────────────────── */
  .sec-cta {
    text-align: center;
    padding: 72px 0 96px;
    border-top: 0;
  }

  .cta-card {
    --channel-fade-duration: 900ms;
    --channel-fade-easing: cubic-bezier(0.22, 1, 0.36, 1);
    position: relative;
    display: grid;
    min-height: 500px;
    overflow: hidden;
    place-items: center;
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 24px;
    background:
      radial-gradient(
        circle at 50% 32%,
        rgba(255, 255, 255, 0.025),
        transparent 30%
      ),
      linear-gradient(180deg, #030304 0%, #07080a 100%);
    box-shadow:
      inset 0 1px rgba(255, 255, 255, 0.06),
      0 42px 120px -64px rgba(0, 0, 0, 0.86);
    isolation: isolate;
    transition:
      border-color var(--channel-fade-duration) var(--channel-fade-easing),
      box-shadow var(--channel-fade-duration) var(--channel-fade-easing);
  }

  .cta-card[data-stage="nightly"] {
    border-color: rgba(139, 129, 255, 0.22);
    box-shadow:
      inset 0 1px rgba(255, 255, 255, 0.07),
      0 42px 120px -64px rgba(85, 59, 183, 0.72);
  }

  .cta-card[data-stage="dev"] {
    border-color: rgba(133, 187, 255, 0.28);
    box-shadow:
      inset 0 1px rgba(255, 255, 255, 0.1),
      0 42px 120px -64px rgba(34, 104, 218, 0.72);
  }

  .cta-card::before,
  .cta-card::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .cta-card::before {
    z-index: 1;
    opacity: 0.045;
    background-image:
      radial-gradient(
        circle,
        rgba(219, 226, 255, 0.72) 0 1px,
        transparent 1.4px
      ),
      radial-gradient(
        circle,
        rgba(147, 166, 255, 0.46) 0 1px,
        transparent 1.5px
      ),
      radial-gradient(
        circle,
        rgba(255, 255, 255, 0.3) 0 0.7px,
        transparent 1.1px
      );
    background-position:
      18px 12px,
      62px 38px,
      11px 54px;
    background-size:
      89px 83px,
      137px 121px,
      61px 67px;
    -webkit-mask-image: linear-gradient(to bottom, #000, rgba(0, 0, 0, 0.64));
    mask-image: linear-gradient(to bottom, #000, rgba(0, 0, 0, 0.64));
    transition: opacity var(--channel-fade-duration) var(--channel-fade-easing);
  }

  .cta-card[data-stage="nightly"]::before {
    opacity: 0.56;
    background-image: url("/nightly-stars.svg");
    background-position: center;
    background-size: cover;
    background-repeat: no-repeat;
  }

  .cta-card[data-stage="dev"]::before {
    opacity: 0.2;
  }

  .cta-card::after {
    z-index: 1;
    background:
      radial-gradient(
        circle at 0% 100%,
        rgba(255, 255, 255, 0.06),
        transparent 28%
      ),
      radial-gradient(
        circle at 100% 0%,
        rgba(255, 255, 255, 0.05),
        transparent 25%
      ),
      linear-gradient(
        115deg,
        transparent 32%,
        rgba(255, 255, 255, 0.022) 50%,
        transparent 68%
      );
  }

  .cta-card-art {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .cta-stage-art {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity var(--channel-fade-duration) var(--channel-fade-easing);
  }

  .cta-card[data-stage="latest"] .cta-stage-art--latest,
  .cta-card[data-stage="nightly"] .cta-stage-art--nightly,
  .cta-card[data-stage="dev"] .cta-stage-art--dev {
    opacity: 1;
  }

  .cta-stage-art--latest {
    background:
      radial-gradient(
        circle at 50% 26%,
        rgba(255, 255, 255, 0.025),
        transparent 36%
      ),
      linear-gradient(180deg, #030304 0%, #07080a 100%);
  }

  .cta-latest-ray {
    position: absolute;
    top: -52%;
    width: 18%;
    height: 142%;
    background: linear-gradient(
      to right,
      transparent,
      rgba(255, 255, 255, 0.018) 30%,
      rgba(255, 255, 255, 0.04) 50%,
      rgba(255, 255, 255, 0.018) 70%,
      transparent
    );
    -webkit-mask-image: linear-gradient(
      to bottom,

    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .hero-title {
    margin: 0 0 20px;
    max-width: 390px;
    font-size: clamp(58px, 5.6vw, 82px);
    font-weight: 500;
    letter-spacing: -0.066em;
    line-height: 0.94;
    text-wrap: balance;
  }

  .hero-title span {
    display: block;
  }

  .hero-concept {
    animation: hero-copy-reveal 0.56s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .hero-title .hero-title-rotator {
    display: grid;

  }

  .section-head {
    margin-bottom: 56px;
    max-width: 720px;
  }

  .section-head h2 {
    font-size: clamp(32px, 4vw, 48px);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1.05;
    margin-bottom: 18px;
  }

  .section-head p {
    color: var(--fg-muted);
    font-size: 18px;
    max-width: 620px;
    letter-spacing: -0.005em;
  }

  .checklist {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .checklist li {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--fg-muted);
    font-size: 15px;
  }

  .checklist li svg {
    color: var(--ok);
    flex-shrink: 0;
  }

  /* ── Hero ─────────────────────────────────────────────────── */
  .hero {
    --channel-fade-duration: 900ms;
    --channel-fade-easing: cubic-bezier(0.22, 1, 0.36, 1);
    padding: 96px 0 72px;
